OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
TZ=Europe/London
OUTPUT_DIR=./output
DATABASE_PATH=./data/stories.sqlite3
PUBLISH_MODE=local
# Reserved for a future publisher; no browser session or password is needed.
SUBSTACK_PUBLICATION_URL=
# A second model call checks language, translation, answers, and scenario novelty.
EDITOR_REVIEW=true
INCLUDE_CTA=true
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2

# Dashboard: use a unique password of at least 16 characters; no default login.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Add your domain here when using an HTTPS reverse proxy (hostnames only).
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_BIND_ADDRESS=127.0.0.1
SCHEDULER_ENABLED=true
LOG_DIR=./logs

